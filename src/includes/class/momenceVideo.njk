{% set hostedVideoUrl = pageSection.videoLibraryUrl | momenceUrl %}
{% if not hostedVideoUrl %}
  {% set hostedVideoUrl = momence.videoLibraryUrl %}
{% endif %}
{% set pluginUrl = momence.videoLibraryPluginUrl %}
{% set accountUrl = momence.accountUrl | momenceUrl %}
{% set featuredPass = pageSection.featuredPass %}
{% set purchaseProvider = featuredPass.purchaseProvider or 'momence' %}
{% set purchaseUrl = featuredPass.purchaseUrl | purchaseUrl(purchaseProvider) %}
{% set purchasePresentation = featuredPass.purchasePresentation | purchasePresentation(purchaseProvider) %}

<section class="section section-padding-top section-padding-bottom momence-video" aria-labelledby="momence-video-heading-{{ pageSection._key | escape }}">
  <div class="container">
    <div class="section-title text-center mb-50">
      <h2 id="momence-video-heading-{{ pageSection._key | escape }}">{{ pageSection.heading or 'On-Demand Video Library' }}</h2>
      {% if pageSection.introduction %}
        <div class="momence-video__introduction">
          {{ pageSection.introduction | blocksToHtml | safe }}
        </div>
      {% endif %}
    </div>

    {% if purchaseUrl or accountUrl %}
      <div class="momence-video__access text-center">
        {% if accountUrl %}
          <p>Already subscribed? Sign in to view your videos.</p>
        {% endif %}
        <div class="momence-video__actions">
          {% if purchaseUrl %}
            <a
              class="btn btn-primary btn-hover-secondary"
              href="{{ purchaseUrl | escape }}"
              target="_blank"
              rel="noopener noreferrer"
              {% if purchasePresentation == 'popup' %}
                data-embed-dialog-url="{{ purchaseUrl | escape }}"
                data-embed-dialog-title="Buy {{ featuredPass.passName | escape }}"
              {% endif %}
            >{{ featuredPass.purchaseButtonLabel or 'Buy On-Demand' }}</a>
          {% endif %}
          {% if accountUrl %}
            <a class="btn btn-outline-primary" href="{{ accountUrl | escape }}" target="_blank" rel="noopener noreferrer">Sign in</a>
          {% endif %}
        </div>
      </div>
    {% endif %}

    {% if pluginUrl %}
      <div class="momence-video__frame-wrap">
        <iframe
          class="momence-video__frame"
          src="{{ pluginUrl | escape }}"
          title="{{ (pageSection.frameTitle or 'Hipline on-demand video library') | escape }}"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="fullscreen"
        ></iframe>
      </div>
    {% endif %}
    {% if hostedVideoUrl %}
      <p class="text-center mt-30">
        <a class="btn btn-primary btn-hover-secondary" href="{{ hostedVideoUrl | escape }}" target="_blank" rel="noopener noreferrer">
          {{ pageSection.fallbackLabel or 'Open the Video Library' }}
        </a>
      </p>
    {% endif %}
    {% if not pluginUrl and not hostedVideoUrl %}
      <p class="text-center">The Video Library is temporarily unavailable.</p>
    {% endif %}
  </div>
</section>
