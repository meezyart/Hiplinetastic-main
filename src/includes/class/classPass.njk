{% macro passBlock(imageClass='',passName='',contentClass='',circleClass='',passPrice=0,bgColor='',color='',mainContent='',passBullets, bulletClass='', buttonClass='btn btn-lg mt-30',buttonTitle='Buy Now',passLink,purchaseUrl='',purchaseProvider='momence',purchaseLabel='',purchasePresentation='popup') %}
    <div class="price-image {{bgColor}} text-white">
        <h4>{{passName}}</h4>
    </div>
    <div class="pricing-content {{contentClass}} ">
        <div class="price-circle {{circleClass}} ">
            {%- if passPrice == 0 or passPrice == null -%}
                <div class="icon">
                    <i class="fas fa-heart fa-4x"></i>
                </div>

            {%- else -%}
                <h3>${{passPrice }}</h3>
            {%- endif -%}
        </div>
        <div class="price-description {{bulletClass}}">
            {% if mainContent %}
                {{mainContent | blocksToHtml | safe }}
            {%- endif -%}
        </div>
        <div >
            {%- if passBullets -%}
                <ul class="{{bulletClass}}">
                    {%- for bullet in passBullets -%}
                        <li>{{bullet}}</li>
                    {%- endfor -%}
                </ul>
            {%- endif -%}
        </div>

        {% set managedPurchaseUrl = purchaseUrl | purchaseUrl(purchaseProvider) %}
        {% set managedPresentation = purchasePresentation | purchasePresentation(purchaseProvider) %}
        {%- if managedPurchaseUrl -%}
            <a href="{{ managedPurchaseUrl | escape }}" class="btn {{buttonClass}} btn-lg mt-30"{% if managedPresentation == 'popup' %} data-embed-dialog-url="{{ managedPurchaseUrl | escape }}" data-embed-dialog-title="Buy {{ passName | escape }}"{% else %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ purchaseLabel or buttonTitle }}</a>
        {%- endif -%}
    </div>
{%- endmacro -%}

<!-- Pass Section Start -->
<div class="section section-padding-top">
    <div class="container">
        {%- if pageSection.dataType == 'classPassSection' -%}
            <!-- Pass Heaader -->
            <div class="section-title text-center mb-95   aos-init" data-aos="fade-up">
                <h2>{{pageSection.passHeadline}}</h2>
                {%- if pageSection.passIntro -%}
                    <p>{{pageSection.passIntro | blocksToHtml | safe }}</p>
                {%- endif -%}
            </div>
            <!-- Pass Wrapper Start -->
            <div class="row row-cols-xl-3 row-cols-lg-3 row-cols-md-1 row-cols-1 max-mb-30 justify-content-center ">
                {% for pass in pageSection.passes %}
                    <div class="col aos-init" data-aos="fade-up">
                        <div class="price-item  animate__animated animate__fadeInUp animate__slow" >
                            {# hot pink #}
                            {% if pageSection.passColor.title == "hot-pink" %}
                            {{ passBlock(
                                passName=pass.passName,
                                circleClass='text-hot-pink',
                                contentClass='bg-pink-extra-light',
                                passPrice=pass.passPrice,
                                color='hot-pink',
                                bgColor='bg-grad-hotpink',
                                mainContent=pass.mainContent,
                                passBullets=pass.passBullets,
                                passLink=pass.passLink,
                                purchaseUrl=pass.purchaseUrl,
                                purchaseProvider=pass.purchaseProvider,
                                purchaseLabel=pass.purchaseButtonLabel,
                                purchasePresentation=pass.purchasePresentation,
                                bulletClass='text-hot-pink',
                                buttonClass='btn btn-hot-pink btn-hover-hot-pink-d50 btn-lg mt-30'
                                )}}
                            {% endif %}
                            {# pink prime #}
                            {%- if pageSection.passColor.title == "pink-prime" -%}
                            {{ passBlock(
                                passName=pass.passName,
                                circleClass='text-pink-prime',
                                contentClass='bg-pink-extra-light',
                                passPrice=pass.passPrice,
                                color='pink-prime',
                                bgColor='bg-grad-pink',
                                mainContent=pass.mainContent,
                                passBullets=pass.passBullets,
                                passLink=pass.passLink,
                                purchaseUrl=pass.purchaseUrl,
                                purchaseProvider=pass.purchaseProvider,
                                purchaseLabel=pass.purchaseButtonLabel,
                                purchasePresentation=pass.purchasePresentation,
                                bulletClass='text-pink-prime',
                                buttonClass='btn btn-pink-prime btn-hover-pink-prime-d50 btn-lg mt-30'
                                )}}

                            {%- endif -%}
                            {# Purple #}
                            {%- if pageSection.passColor.title == "purple" -%}
                             {{ passBlock(
                                passName=pass.passName,
                                contentClass='bg-purple-light ',
                                circleClass='text-purple-d50',
                                passPrice=pass.passPrice,
                                bgColor='bg-grad-purple',
                                color='purple',
                                mainContent=pass.mainContent,
                                passBullets=pass.passBullets,
                                passLink=pass.passLink,
                                purchaseUrl=pass.purchaseUrl,
                                purchaseProvider=pass.purchaseProvider,
                                purchaseLabel=pass.purchaseButtonLabel,
                                purchasePresentation=pass.purchasePresentation,
                                bulletClass='text-purple',
                                buttonClass='btn btn-purple btn-hover-purple-d50 btn-lg mt-30'
                                )}}

                            {%- endif -%}
                            {# Blue #}
                            {%- if pageSection.passColor.title == "blue" -%}
                             {{ passBlock(
                                passName=pass.passName,
                                contentClass='bg-seafoam-extra-light',
                                circleClass='text-seafoam-light',
                                passPrice=pass.passPrice,
                                bgColor='bg-grad-green',
                                color='seafoam-light',
                                mainContent=pass.mainContent,
                                passBullets=pass.passBullets,
                                passLink=pass.passLink,
                                purchaseUrl=pass.purchaseUrl,
                                purchaseProvider=pass.purchaseProvider,
                                purchaseLabel=pass.purchaseButtonLabel,
                                purchasePresentation=pass.purchasePresentation,
                                bulletClass='text-seafoam-light-d50',
                                buttonClass='btn btn-seafoam-light btn-hover-seafoam-light-d50 btn-lg mt-30'
                                )}}

                            {% endif %}
                            {#  Teal #}
                            {% if pageSection.passColor.title == "teal" %}
                             {{ passBlock(
                                passName=pass.passName,
                                contentClass='bg-teal-light',
                                circleClass='text-teal-d30',
                                passPrice=pass.passPrice,
                                bgColor='bg-grad-teal',
                                color='teal',
                                mainContent=pass.mainContent,
                                passBullets=pass.passBullets,
                                passLink=pass.passLink,
                                purchaseUrl=pass.purchaseUrl,
                                purchaseProvider=pass.purchaseProvider,
                                purchaseLabel=pass.purchaseButtonLabel,
                                purchasePresentation=pass.purchasePresentation,
                                bulletClass='text-teal-d50',
                                buttonClass='btn btn-teal btn-hover-teal-d50 btn-lg mt-30'
                                )}}

                            {%- endif -%}
                            {# orange section #}
                            {%- if pageSection.passColor.title == "ceren-orange" -%}
                               {{ passBlock(
                                passName=pass.passName,
                                contentClass='bg-ceren-orange-l20',
                                circleClass='text-ceren-orange-d10',
                                passPrice=pass.passPrice,
                                bgColor='bg-grad-orange',
                                color='ceren-orange',
                                mainContent=pass.mainContent,
                                passBullets=pass.passBullets,
                                passLink=pass.passLink,
                                purchaseUrl=pass.purchaseUrl,
                                purchaseProvider=pass.purchaseProvider,
                                purchaseLabel=pass.purchaseButtonLabel,
                                purchasePresentation=pass.purchasePresentation,
                                bulletClass='text-ceren-orange-d50',
                                buttonClass='btn btn-ceren-orange btn-hover-ceren-orange-d50 btn-lg mt-30'
                                )}}

                            {%- endif -%}

                        </div>
                    </div>
                {%- endfor -%}

            </div>
            <!-- Pass Wrapper End -->
    {%- else -%}
        <p>No pass available.</p>

    {%- endif -%}

</div>
</div>
<!-- Course Section End -->
