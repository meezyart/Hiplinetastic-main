{% from "macros/menuLink.njk" import menuLinkAttributes %}
<!-- Header Section Start -->
<div class="header-section header-shadow sticky-header section">
    <div class="header-inner">
        <div class="container position-relative">
            <div class="row justify-content-between align-items-center">

                <!-- Header Logo Start -->
                <div class="col-xl-2 col-auto">
                    <div class="header-logo">
                        <a href="{{ '/' | url }}">{% set darkLogo %}{% imageUrl settings.logo.darkLogo.url %}{% endset %}
                            {% set lightLogo %}{% imageUrl settings.logo.lightLogo.url %}{% endset %}
                            <img srcset="{% imageSrcset darkLogo %}" class="dark-logo" data-sizes="auto" alt="Logo">
                            <img srcset="{% imageSrcset lightLogo %}" class="light-logo" data-sizes="auto" alt="Logo"></a>
                            </div>
                </div>
                <!-- Header Logo End -->

                <!-- Header Main Menu Start -->
                <div class="col d-none d-xl-block position-static">
                    {% if sections.header.menu %}
                        <nav class="site-main-menu menu-hover-1">
                            <ul>
                                {# <li class=" position-static">
                                    <a href="{{ '/' | url }}">
                                        <span class="menu-text">Home</span></a>
                                </li> #}

                                {% for menuItem in sections.header.menu %}
                                    <li {% if menuItem.dropdownItems %} class="has-children"  {% endif %}>
                                        <a {{ menuLinkAttributes(menuItem) }}>
                                            <span class="menu-text" >{{ menuItem.name }}</span></a>
                                        <span class="menu-toggle">
                                            <i class="far fa-angle-down"></i>
                                        </span>
                                        {% if menuItem.dropdownItems%}
                                            <ul class="sub-menu">
                                                {% for dropMenuItem in menuItem.dropdownItems %}
                                                    <li>
                                                        <a {{ menuLinkAttributes(dropMenuItem) }}>
                                                            <span class="menu-tex">{{ dropMenuItem.name }}</span></a>
                                                        <span class="menu-toggle">
                                                            <i class="far fa-angle-down"></i>
                                                        </span>
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        </nav>
                    {% endif %}
                </div>
                <!-- Header Main Menu End -->

                <!-- Header Right Start -->
                <div class="col-auto">
                    <div class="header-right">
                        <div class="inner">
                            {% if sections.header.showCart and momence.cartUrl %}
                                <div class="header-cart">
                                    <a href="{{ momence.cartUrl | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Open your Hipline cart">
                                        <i class="far fa-shopping-cart" aria-hidden="true"></i>
                                    </a>
                                </div>
                            {% endif %}
                            <!-- Header Login Start -->
                            {% if sections.header.showLogin %}
                                <div class="header-login">
                                    <a href="{{ momence.accountUrl | escape }}" target="_blank" rel="noopener noreferrer" aria-label="Sign in to your Hipline account">
                                        <i class="far fa-user-circle" aria-hidden="true"></i>
                                    </a>
                                </div>

                            {% endif %}
                            <!-- Header Login End -->

                            <!-- Heade
                            r Social Start -->
                            <div class="header-sociax d-none d-sm-flex">
                            {% if sections.header.showButton %}
                                <a {% if sections.header.cta%} href="{% if sections.header.cta.link %}{{sections.header.cta.link | url }}{%elseif sections.header.cta.internal%}/{{sections.header.cta.internal  }}{%elseif sections.header.cta.route%}{{sections.header.cta.route}}{% endif %}" {% if sections.header.cta.openInNewTab %}target="_blank"{% endif %} {% endif %} class="btn btn-primary btn-hover-secondary">{% if sections.header.cta.title %}{{sections.header.cta.title  }}{% endif %}</a>

                                {% endif %}
                                {# <a href="#"><i class="fab fa-twitter"></i></a>
                                        <a href="#"><i class="fab fa-facebook-f"></i></a>
                                        <a href="#"><i class="fab fa-instagram"></i></a>
                                        <a href="#"><i class="fab fa-linkedin"></i></a> #}
                            </div>
                            <!-- Header Social End -->

                            <!-- Header Mobile Menu Toggle Start -->
                            <div class="header-mobile-menu-toggle d-xl-none ml-sm-2">
                                <button class="toggle">
                                    <i class="icon-top"></i>
                                    <i class="icon-middle"></i>
                                    <i class="icon-bottom"></i>
                                </button>
                            </div>
                            <!-- Header Mobile Menu Toggle End -->
                        </div>
                    </div>
                </div>
                <!-- Header Right End -->

            </div>
        </div>
    </div>
</div>

<!-- Header Section End -->
